        <mxCell id="collecte_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#0066cc;rounded=0;" value="&amp;nbsp;APP COLLECTE (Saisie des données)" vertex="1">
