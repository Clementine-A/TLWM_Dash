        <mxCell id="rbac_superv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" value="&amp;nbsp;SUPERVISEUR_DISTRICT&lt;br&gt;─────────────────&lt;br&gt;Accès: Son district uniquement&lt;br&gt;• Toutes les assemblées du district&lt;br&gt;• Saisie rapports district&lt;br&gt;• Vue consolidée du district&lt;br&gt;• Pas de gestion utilisateurs" vertex="1">
