        <mxCell id="collecte_tech" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#555;" value="React + Vite + TailwindCSS  |  Port: dev/dist  |  /collecte" vertex="1">
