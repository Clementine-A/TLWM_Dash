        <mxCell id="rbac_admin_pays" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" value="&amp;nbsp;ADMIN_PAYS&lt;br&gt;─────────────────&lt;br&gt;Accès: Son pays uniquement&lt;br&gt;• Tous les districts et assemblées de son pays&lt;br&gt;• CRUD utilisateurs de son pays&lt;br&gt;• Ne peut pas créer ADMIN_AFRIQUE&lt;br&gt;• Rapports nationaux de son pays" vertex="1">
