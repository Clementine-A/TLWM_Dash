        </mxCell>
        <mxCell id="auth_ctx" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;AuthContext.jsx&lt;br&gt;(Context React)&lt;br&gt;&lt;br&gt;• user, token (localStorage)&lt;br&gt;• login() / logout()&lt;br&gt;• loading state" vertex="1">
          <mxGeometry height="110" width="200" x="50" y="385" as="geometry" />
        </mxCell>
        <mxCell id="login_page" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;LoginPage.jsx&lt;br&gt;&lt;br&gt;• Formulaire Email / Password&lt;br&gt;• Inscription (register)&lt;br&gt;• Gestion statut EN_ATTENTE&lt;br&gt;• Rôle demandé à l&#39;inscription" vertex="1">
          <mxGeometry height="110" width="210" x="270" y="385" as="geometry" />
        </mxCell>
        <mxCell id="collecte_app" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;App.jsx (Router)&lt;br&gt;&lt;br&gt;RÔLES &amp;amp; ACCÈS :&lt;br&gt;• ADMIN_AFRIQUE → tout&lt;br&gt;• ADMIN_PAYS → son pays&lt;br&gt;• SUPERVISEUR_DISTRICT → son district&lt;br&gt;• RAPPORTEUR_ASSEMBLEE → son assemblée&lt;br&gt;&lt;br&gt;Navigation filtrée selon le rôle" vertex="1">
          <mxGeometry height="150" width="220" x="490" y="385" as="geometry" />
        </mxCell>
        <mxCell id="admin_dash" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;AdminDashboardPage.jsx&lt;br&gt;&lt;br&gt;• Stats consolidées nationales&lt;br&gt;• KPIs : membres, séminaires, sauvés&lt;br&gt;• Graphiques mensuels&lt;br&gt;• Filtres : année, district&lt;br&gt;Rôles: MID_ROLES+" vertex="1">
          <mxGeometry height="130" width="210" x="50" y="525" as="geometry" />
        </mxCell>
        <mxCell id="rapport_asm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;RapportAssembleePage.jsx&lt;br&gt;&lt;br&gt;• Saisie mensuelle assemblée&lt;br&gt;• Séminaires (en assemblée / hors)&lt;br&gt;• Assistance cultes / mission&lt;br&gt;• Sauvés, ajoutés, témoignages&lt;br&gt;• Membres, prédicateurs, pasteurs&lt;br&gt;• Finances: offrandes, dîmes, BP...&lt;br&gt;• Comité de l&#39;assemblée&lt;br&gt;• Membres de l&#39;assemblée (CRUD)&lt;br&gt;• Activités de l&#39;assemblée&lt;br&gt;Rôles: ALL_ROLES" vertex="1">
          <mxGeometry height="200" width="210" x="270" y="510" as="geometry" />
        </mxCell>
        <mxCell id="rapport_dist" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;RapportDistrictPage.jsx&lt;br&gt;&lt;br&gt;• Activités propres du district&lt;br&gt;• Tableau des activités (CRUD)&lt;br&gt;• Type: Formation, CPPD, Évangélisation...&lt;br&gt;• Participants: H / F / Jeunes / +Jeunes&lt;br&gt;• Réussites &amp;amp; difficultés&lt;br&gt;Rôles: MID_ROLES" vertex="1">
          <mxGeometry height="155" width="210" x="490" y="555" as="geometry" />
        </mxCell>
        <mxCell id="rapport_nat" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;RapportNationalPage.jsx&lt;br&gt;&lt;br&gt;• Activités nationales par pays&lt;br&gt;• Même structure que district&lt;br&gt;• Filtré par pays_id de l&#39;utilisateur&lt;br&gt;Rôles: HIGH_ROLES" vertex="1">
          <mxGeometry height="110" width="210" x="50" y="675" as="geometry" />
        </mxCell>
        <mxCell id="gestion_pays" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;GestionPaysPage.jsx&lt;br&gt;&lt;br&gt;• CRUD Pays (code, nom)&lt;br&gt;• CRUD Districts (par pays)&lt;br&gt;• CRUD Assemblées (par district)&lt;br&gt;• Statistiques par pays&lt;br&gt;Rôles: ADMIN_AFRIQUE" vertex="1">
          <mxGeometry height="130" width="210" x="490" y="730" as="geometry" />
        </mxCell>
        <mxCell id="gestion_users" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" value="&amp;nbsp;GestionUtilisateursPage.jsx&lt;br&gt;&lt;br&gt;• Lister / Filtrer les utilisateurs&lt;br&gt;• Créer un compte (ACTIF direct)&lt;br&gt;• Modifier rôle / portée / statut&lt;br&gt;• Valider / Rejeter comptes EN_ATTENTE&lt;br&gt;• Réinitialiser mot de passe&lt;br&gt;• Supprimer un utilisateur&lt;br&gt;Rôles: ADMIN_AFRIQUE + ADMIN_PAYS" vertex="1">
          <mxGeometry height="160" width="210" x="270" y="730" as="geometry" />
        </mxCell>
        <mxCell id="api_client" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;api.js (Client API)&lt;br&gt;&lt;br&gt;BASE_URL: http://localhost:5000/api&lt;br&gt;Token: localStorage &#39;tlwm_token&#39;&lt;br&gt;Auto-logout si 401/403&lt;br&gt;&lt;br&gt;Fonctions exportées:&lt;br&gt;• login(), register()&lt;br&gt;• getPays/Districts/Assemblees()&lt;br&gt;• getRapportsAssemblee()&lt;br&gt;• submitRapportAssembleeComplet()&lt;br&gt;• getActivites() / addActivite()&lt;br&gt;• getMembres() / addMembre()&lt;br&gt;• getFinancesAssemblee()&lt;br&gt;• getDashboardStats()&lt;br&gt;• getAdminUtilisateurs()..." vertex="1">
          <mxGeometry height="320" width="640" x="50" y="895" as="geometry" />
        </mxCell>
        <mxCell id="backend_bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=20;" value="" vertex="1">
          <mxGeometry height="960" width="860" x="760" y="320" as="geometry" />
        </mxCell>
        <mxCell id="backend_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#cc8800;" value="&amp;nbsp;BACKEND API (Node.js / Express)" vertex="1">
          <mxGeometry height="35" width="860" x="760" y="325" as="geometry" />
        </mxCell>
        <mxCell id="backend_tech" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#555;" value="Express.js  |  bcryptjs  |  jsonwebtoken  |  pg (node-postgres)  |  dotenv  |  Port: 5000" vertex="1">
          <mxGeometry height="20" width="860" x="760" y="355" as="geometry" />
        </mxCell>
        <mxCell id="middlewares" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Middlewares&lt;br&gt;&lt;br&gt;• cors() — Autorise les origines frontend&lt;br&gt;• express.json() — Parse le body JSON&lt;br&gt;• authenticateToken() — Vérifie JWT Bearer&lt;br&gt;• requireAdmin() — Vérifie rôle ADMIN_*" vertex="1">
          <mxGeometry height="110" width="310" x="780" y="385" as="geometry" />
        </mxCell>
        <mxCell id="dbjs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;db.js (Pool PostgreSQL)&lt;br&gt;&lt;br&gt;• pg.Pool — connexions multiples&lt;br&gt;• PGHOST / PGPORT / PGDATABASE&lt;br&gt;• PGUSER / PGPASSWORD (.env)&lt;br&gt;• SSL en production" vertex="1">
          <mxGeometry height="110" width="285" x="1110" y="385" as="geometry" />
        </mxCell>
        <mxCell id="route_auth" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Auth Routes&lt;br&gt;&lt;br&gt;POST /api/auth/login&lt;br&gt;  → Vérif email + password (bcrypt)&lt;br&gt;  → Contrôle statut ACTIF/EN_ATTENTE/REJETE&lt;br&gt;  → Retourne JWT (24h) + user payload&lt;br&gt;&lt;br&gt;POST /api/auth/register&lt;br&gt;  → Création compte statut EN_ATTENTE&lt;br&gt;  → Rôle RAPPORTEUR_ASSEMBLEE par défaut" vertex="1">
          <mxGeometry height="175" width="290" x="780" y="525" as="geometry" />
        </mxCell>
        <mxCell id="route_admin_users" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Admin Utilisateurs (protégé Admin)&lt;br&gt;&lt;br&gt;GET    /api/admin/utilisateurs [?filtres]&lt;br&gt;POST   /api/admin/utilisateurs&lt;br&gt;PUT    /api/admin/utilisateurs/:id&lt;br&gt;PATCH  /api/admin/utilisateurs/:id/statut&lt;br&gt;PATCH  /api/admin/utilisateurs/:id/reset-password&lt;br&gt;DELETE /api/admin/utilisateurs/:id&lt;br&gt;&lt;br&gt;RBAC: ADMIN_AFRIQUE voit tout&lt;br&gt;       ADMIN_PAYS voit son pays seul" vertex="1">
          <mxGeometry height="175" width="300" x="1080" y="525" as="geometry" />
        </mxCell>
        <mxCell id="route_ref" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Référentiel (Pays / Districts / Assemblées)&lt;br&gt;&lt;br&gt;GET    /api/referentiel/pays&lt;br&gt;GET    /api/referentiel/pays-stats&lt;br&gt;POST   /api/referentiel/pays [auth]&lt;br&gt;PUT    /api/referentiel/pays/:id [auth]&lt;br&gt;DELETE /api/referentiel/pays/:id [auth]&lt;br&gt;GET    /api/referentiel/pays/:id/stats&lt;br&gt;&lt;br&gt;GET    /api/referentiel/districts [?pays_id]&lt;br&gt;POST/PUT/DELETE /api/referentiel/districts/:id [auth]&lt;br&gt;&lt;br&gt;GET    /api/referentiel/assemblees [?district_id]&lt;br&gt;POST/PUT/DELETE /api/referentiel/assemblees/:id [auth]" vertex="1">
          <mxGeometry height="220" width="310" x="780" y="720" as="geometry" />
        </mxCell>
        <mxCell id="route_rapports" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Rapports Assemblée&lt;br&gt;&lt;br&gt;GET  /api/rapports/assemblee [?filtres]&lt;br&gt;POST /api/rapports/assemblee&lt;br&gt;     → UPSERT (ON CONFLICT)&lt;br&gt;&lt;br&gt;GET  /api/rapports/assemblee/historique&lt;br&gt;POST /api/rapports/assemblee/complet&lt;br&gt;     → Version étendue (33 champs)&lt;br&gt;     → Réussites, difficultés, besoins" vertex="1">
          <mxGeometry height="175" width="300" x="1100" y="720" as="geometry" />
        </mxCell>
        <mxCell id="route_activites" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Activités (Unified Table)&lt;br&gt;&lt;br&gt;GET/POST/PUT/DELETE /api/activites&lt;br&gt;  → ?niveau=assemblee|district|national&lt;br&gt;  → ?assemblee_id / district_id / pays_id&lt;br&gt;&lt;br&gt;GET/POST /api/activites-district&lt;br&gt;GET/POST /api/activites-national&lt;br&gt;&lt;br&gt;Table &#39;activites&#39;: niveau + portée&lt;br&gt;(assemblee_id OR district_id OR pays_id)" vertex="1">
          <mxGeometry height="175" width="300" x="780" y="960" as="geometry" />
        </mxCell>
        <mxCell id="route_membres" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Membres &amp;amp; Comité&lt;br&gt;&lt;br&gt;GET/POST/DELETE /api/comite/:assembleeId&lt;br&gt;GET/PUT/DELETE  /api/comite/membre/:id&lt;br&gt;&lt;br&gt;GET    /api/membres/:assembleeId [?filtres]&lt;br&gt;GET    /api/membres/:assembleeId/stats&lt;br&gt;POST   /api/membres/:assembleeId&lt;br&gt;PUT    /api/membres/:id&lt;br&gt;DELETE /api/membres/:id&lt;br&gt;&lt;br&gt;24 champs étendus (salut, baptême,&lt;br&gt;profession, quartier, assiduite...)" vertex="1">
          <mxGeometry height="200" width="300" x="1100" y="915" as="geometry" />
        </mxCell>
        <mxCell id="route_dash_fin" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" value="&amp;nbsp;Dashboard &amp;amp; Finances&lt;br&gt;&lt;br&gt;GET /api/dashboard/stats?annee=X&lt;br&gt;  → Agrégation par mois (SUM)&lt;br&gt;  → sem_total, assistance, sauvés...&lt;br&gt;&lt;br&gt;GET/POST /api/finances/assemblee&lt;br&gt;  → Ventilation Offrandes / Dîmes / BP / DOVOCOQ&lt;br&gt;  → % par niveau: Asm / Dist / Coord / Afrique&lt;br&gt;  → UPSERT par (assemblee_id, annee, mois)&lt;br&gt;&lt;br&gt;GET /api/health → Status check" vertex="1">
          <mxGeometry height="160" width="620" x="780" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="db_bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=20;" value="" vertex="1">
          <mxGeometry height="1620" width="1270" x="1660" y="320" as="geometry" />
        </mxCell>
        <mxCell id="db_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#338833;" value="&amp;nbsp;BASE DE DONNÉES PostgreSQL_tlwm_db" vertex="1">
          <mxGeometry height="35" width="1100" x="1660" y="325" as="geometry" />
        </mxCell>
        <mxCell id="db_tech" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#555;" value="PostgreSQL  |  port: 5432  |  Extension: uuid-ossp  |  Node pool: pg" vertex="1">
          <mxGeometry height="20" width="1100" x="1660" y="355" as="geometry" />
        </mxCell>
        <mxCell id="t_pays" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" value="&amp;nbsp;TABLE: pays&lt;br&gt;─────────────────────────────&lt;br&gt;&amp;nbsp;id           SERIAL PK&lt;br&gt;   code_pays    VARCHAR(10) UNIQUE&lt;br&gt;   nom_pays     VARCHAR(100)&lt;br&gt;   created_at   TIMESTAMP&lt;br&gt;─────────────────────────────&lt;br&gt;Exemples: TG=Togo, BJ=Bénin, CI=Côte d&#39;Ivoire" vertex="1">
          <mxGeometry height="155" width="320" x="1680" y="390" as="geometry" />
        </mxCell>
        <mxCell id="t_districts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" value="&amp;nbsp;TABLE: districts&lt;br&gt;─────────────────────────────&lt;br&gt;&amp;nbsp;id             SERIAL PK&lt;br&gt;⊶  pays_id        FK → pays(id) CASCADE&lt;br&gt;   code_district  VARCHAR(50) UNIQUE&lt;br&gt;   nom_district   VARCHAR(100)&lt;br&gt;   created_at     TIMESTAMP&lt;br&gt;   updated_at     TIMESTAMP&lt;br&gt;─────────────────────────────&lt;br&gt;Index: idx_assemblees_district" vertex="1">
          <mxGeometry height="175" width="320" x="2020" y="390" as="geometry" />
        </mxCell>
        <mxCell id="t_assemblees" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" value="&amp;nbsp;TABLE: assemblees&lt;br&gt;─────────────────────────────&lt;br&gt;&amp;nbsp;id                  SERIAL PK&lt;br&gt;⊶  district_id         FK → districts(id) CASCADE&lt;br&gt;   code_assemblee      VARCHAR(50) UNIQUE&lt;br&gt;   nom_assemblee       VARCHAR(150)&lt;br&gt;   type_unite          VARCHAR(50) [Assemblée|Cellule]&lt;br&gt;   pasteur_responsable VARCHAR(150)&lt;br&gt;   latitude            NUMERIC(10,6)&lt;br&gt;   longitude           NUMERIC(10,6)&lt;br&gt;   effectif_base       INTEGER&lt;br&gt;   created_at / updated_at" vertex="1">
          <mxGeometry height="205" width="360" x="2530" y="360" as="geometry" />
        </mxCell>
        <mxCell id="t_utilisateurs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" value="&amp;nbsp;TABLE: utilisateurs&lt;br&gt;─────────────────────────────&lt;br&gt;&amp;nbsp;id            SERIAL PK&lt;br&gt;   nom            VARCHAR(100)&lt;br&gt;   email          VARCHAR(150) UNIQUE&lt;br&gt;   password_hash  VARCHAR(255) [bcrypt]&lt;br&gt;   role           VARCHAR(50):&lt;br&gt;     • ADMIN_AFRIQUE&lt;br&gt;     • ADMIN_PAYS&lt;br&gt;     • SUPERVISEUR_DISTRICT&lt;br&gt;     • RAPPORTEUR_ASSEMBLEE&lt;br&gt;   statut         [ACTIF|EN_ATTENTE|REJETE|INACTIF]&lt;br&gt;⊶  pays_id        FK → pays(id) SET NULL&lt;br&gt;⊶  district_id    FK → districts(id) SET NULL&lt;br&gt;⊶  assemblee_id   FK → assemblees(id) SET NULL&lt;br&gt;   created_at" vertex="1">
          <mxGeometry height="285" width="350" x="1680" y="575" as="geometry" />
